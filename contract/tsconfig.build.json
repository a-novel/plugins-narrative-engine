{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // The package runs in a browser and a Worker: without Node's types, a Node API fails the build.
    "types": [],
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "declaration": true,
    "rootDir": "src",
    "outDir": "dist"
  },
  "exclude": ["src/**/*.test.ts", "src/**/*.fixture.ts"]
}
