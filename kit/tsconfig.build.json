{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // The build reads the contract as a plugin does: the built package.
    "paths": {},
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "declaration": true,
    "rootDir": "src",
    "outDir": "dist"
  },
  "exclude": ["src/**/*.test.ts", "src/**/*.fixture.ts"]
}
