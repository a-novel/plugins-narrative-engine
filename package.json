{
  "name": "plugins-narrative-engine-project",
  "version": "0.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a-novel/plugins-narrative-engine.git"
  },
  "license": "RPL-1.5",
  "type": "module",
  "scripts": {
    "build": "tsc -p contract/tsconfig.build.json && tsc -p kit/tsconfig.build.json",
    "check:plugins": "pnpm --filter \"./plugins/*\" exec plugin-kit check",
    "format": "prettier --write . --config prettier.config.ts",
    "preinstall": "npx only-allow pnpm",
    "lint": "pnpm lint:stylecheck && pnpm lint:typecheck && pnpm lint:eslint",
    "lint:eslint": "eslint .",
    "lint:stylecheck": "prettier --check . --config prettier.config.ts",
    "lint:typecheck": "tsc --noEmit && tsc -p contract --noEmit && tsc -p kit --noEmit && svelte-check --tsconfig kit/test/tsconfig.json && tsc -p plugins --noEmit",
    "test": "vitest run",
    "test:ci": "pnpm build && pnpm test && pnpm check:plugins"
  },
  "devDependencies": {
    "@a-novel-kit/nodelib-config": "^2.14.0",
    "@a-novel-kit/nodelib-i18n": "^2.14.0",
    "@a-novel-kit/uikit": "^0.28.0",
    "@a-novel/plugins-narrative-engine-kit": "workspace:*",
    "@eslint/compat": "^2.1.1",
    "@eslint/config-helpers": "^0.7.0",
    "@eslint/js": "^10.0.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^26.6.6",
    "@vitest/browser-playwright": "5.1.1",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "i18next": "^27.2.3",
    "jiti": "^2.6.1",
    "playwright": "1.65.1",
    "prettier": "^3.10.1",
    "prettier-plugin-css-order": "^2.2.0",
    "prettier-plugin-packagejson": "^3.1.0",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "5.1.1"
  },
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.9.2"
  }
}
